FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# 1. Install Python 3.8 and make it default
RUN apt update && apt install -y \
    curl gnupg software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt update \
    && apt install -y python3.8 python3.8-dev python3.8-distutils \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.8 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.8 \
    && rm -rf /var/lib/apt/lists/*

# 2. Add Coral repository
RUN curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/coral.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/coral.gpg] https://packages.cloud.google.com/apt coral-edgetpu-stable main" > /etc/apt/sources.list.d/coral.list

# 3. Install Coral dependencies
RUN apt update && apt install -y \
    libedgetpu1-std \
    && python3.8 -m pip install --extra-index-url https://google-coral.github.io/py-repo/ pycoral==2.0.0 \
    && rm -rf /var/lib/apt/lists/*

# 4. Copy only necessary files
WORKDIR /app
COPY test.py .

# 5. Set up environment
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

CMD ["python3", "test.py"]
